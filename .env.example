# ── SmartQueue Database (ตารางของระบบใหม่ แยกจาก HOSxP) ──────────────────
SQ_DB_HOST=127.0.0.1
SQ_DB_PORT=3306
SQ_DB_NAME=smartqueue
SQ_DB_USER=root
SQ_DB_PASS=

# ── HOSxP Database (maetha) ────────────────────────────────────────────────
# SELECT + UPDATE บางตาราง (ดูรายละเอียดใน smartqueue_new_architecture.md)
HOSXP_DB_HOST=192.168.100.3
HOSXP_DB_PORT=3306
HOSXP_DB_NAME=maetha
HOSXP_DB_USER=
HOSXP_DB_PASS=

# ── Application ────────────────────────────────────────────────────────────
PORT=19010
JWT_SECRET=change_this_to_a_long_random_secret_string
SESSION_EXPIRE_HOURS=8
HOST=0.0.0.0

# ── Socket.IO ──────────────────────────────────────────────────────────────
# ใส่ IP ของเครื่อง/เซิร์ฟเวอร์ที่ client จะเชื่อมต่อมา (comma-separated)
SOCKET_CORS_ORIGIN=http://localhost:19010,http://127.0.0.1:19010

# ── Legacy System (ระบบเดิมที่ยังทำงานอยู่ระหว่าง migration) ─────────────
LEGACY_SIGNAL_URL=http://192.168.100.51:19009
